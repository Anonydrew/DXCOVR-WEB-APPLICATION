# -----------------------------------------------------------------------------
# DXCOVR — environment template
# Copy to .env and fill in real values. Never commit .env.
# Values below are safe production defaults; local development notes inline.
# -----------------------------------------------------------------------------

APP_NAME=DXCOVR
APP_ENV=production
APP_KEY=
# Must be false in production so stack traces and paths are never shown.
APP_DEBUG=false
# Full public URL including https://. Used for links, canonical URLs and the sitemap.
APP_URL=https://www.example.com
APP_TIMEZONE=Africa/Accra

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Database (MySQL/MariaDB in production; sqlite works for local development)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dxcovr
DB_USERNAME=dxcovr
DB_PASSWORD=

# --- Sessions (secure cookies require HTTPS)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# On shared hosting the scheduler runs the queue worker every minute.
# Set to false if a supervisor-managed `php artisan queue:work` is running instead.
QUEUE_WORK_VIA_SCHEDULER=true

# --- Mail (use your provider's SMTP credentials; "log" writes emails to the log)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Receives enquiry/application notifications until recipients are set in
# Admin → Settings → Notifications.
NOTIFICATION_FALLBACK_EMAIL=

# --- Local development only (ignored unless APP_ENV=local)
# `php artisan db:seed` creates a Super Administrator from these values.
# In production use `php artisan dxcovr:create-admin` instead.
LOCAL_ADMIN_EMAIL=
LOCAL_ADMIN_PASSWORD=

# --- Media storage
# "public" stores media in storage/app/public (requires `php artisan storage:link`).
# Switch to "s3" (and fill the AWS_* values) for object storage.
MEDIA_DISK=public
# Extra hosts allowed for images inside rich text, e.g. a CDN (comma separated).
MEDIA_EXTRA_HOSTS=
# Private disk for job-application CVs. Must never be web accessible.
CV_DISK=local

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Spam protection (honeypot, timing and rate limits are always on)
# Optional CAPTCHA: set CAPTCHA_DRIVER=turnstile with Cloudflare Turnstile keys.
CAPTCHA_DRIVER=none
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
FORM_MINIMUM_SECONDS=3

# --- Security headers
# Enable HSTS only once HTTPS works on every subdomain you use.
SECURITY_HSTS=false
SECURITY_CSP=true

VITE_APP_NAME="${APP_NAME}"
